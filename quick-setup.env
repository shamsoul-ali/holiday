# =============================================================================
# HOLIDAY AI PLATFORM - QUICK SETUP
# =============================================================================
# Copy this file to .env and replace the placeholder values with your actual API keys

# =============================================================================
# PRIORITY APIS (Configure these first for immediate functionality)
# =============================================================================

# OpenWeather API (FREE - 1,000 calls/day)
# Get from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here

# OpenAI API (PAID - $20 minimum)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_key_here

# Google Places API (FREE - 100,000 requests/month)
# Get from: https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=your_google_places_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# =============================================================================
# TRAVEL SEARCH APIS (High Impact)
# =============================================================================

# Amadeus Travel API (FREE - 2,000 calls/month)
# Get from: https://developers.amadeus.com/
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
AMADEUS_ENVIRONMENT=test

# Kiwi/Tequila API (FREE - 1,000 calls/month)
# Get from: https://tequila.kiwi.com/portal/login
KIWI_API_KEY=your_kiwi_api_key

# =============================================================================
# PAYMENT PROCESSING
# =============================================================================

# Stripe (FREE - 2.9% per transaction)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# iPay88 Malaysia (Optional - for Malaysian market)
# Get from: https://www.ipay88.com/
IPAY88_MERCHANT_KEY=your_ipay88_merchant_key
IPAY88_MERCHANT_CODE=your_merchant_code
IPAY88_SIGNATURE_KEY=your_signature_key

# =============================================================================
# OPTIONAL APIS (Add later for expanded functionality)
# =============================================================================

# Anthropic Claude (Alternative to OpenAI)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# Expedia Rapid API (Hotels)
# Get from: https://developers.expediagroup.com/
EXPEDIA_RAPID_API_KEY=your_expedia_rapid_key_here

# GetYourGuide API (Activities)
# Get from: https://partner.getyourguide.com/
GETYOURGUIDE_API_KEY=your_getyourguide_key_here

# Viator API (Experiences)
# Get from: https://developer.viator.com/
VIATOR_API_KEY=your_viator_api_key_here

# Ticketmaster API (Events)
# Get from: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=your_ticketmaster_key_here

# Skyscanner API (Flight comparison)
# Get from: https://rapidapi.com/skyscanner/
SKYSCANNER_API_KEY=your_skyscanner_key_here

# Duffel API (Modern flight search)
# Get from: https://duffel.com/
DUFFEL_API_KEY=your_duffel_api_key_here

# Klook API (Asia activities)
# Get from: https://www.klook.com/
KLOOK_API_KEY=your_klook_api_key_here

# =============================================================================
# EXISTING CONFIGURATION (Keep these as-is)
# =============================================================================

# Web App
NEXT_PUBLIC_APP_URL=http://localhost:3010
WEB_PORT=3010
API_PORT=8000

# Database
DATABASE_URL=postgresql://holiday_user:holiday_pass@localhost:5432/holiday_ai
POSTGRES_DB=holiday_ai
POSTGRES_USER=holiday_user
POSTGRES_PASSWORD=holiday_pass

# Redis Cache
REDIS_URL=redis://localhost:6379

# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO