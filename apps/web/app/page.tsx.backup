                      <div className="flex justify-between items-center">
                        <span className="text-cyan-300 font-bold text-lg">RM {demoForm.budget.toLocaleString()}</span>
                        <div className="flex gap-2">
                          <span className={`text-xs px-2 py-1 rounded-full font-semibold ${getBudgetCategory(demoForm.budget).color} bg-white/20`}>
