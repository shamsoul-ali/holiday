                        </button>
                        <button className="text-center py-1">
                          <div className="w-2 h-2 bg-yellow-400 rounded-full mx-auto mb-1"></div>
                          Comfort
                        </button>
                        <button className="text-center py-1">
                          <div className="w-2 h-2 bg-blue-400 rounded-full mx-auto mb-1"></div>
                          Premium
                        </button>
                        <button className="text-center py-1">
                          <div className="w-2 h-2 bg-purple-400 rounded-full mx-auto mb-1"></div>
                          Luxury
                        </button>
                      </div>
                    </div>
                  </div>
                  
                  {/* Travel Details */}
                  <div className="space-y-4">
                    <div className="grid grid-cols-2 gap-4">
                      <div>
                        <label className="block text-sm font-semibold text-blue-200 mb-2">👥 Travelers</label>
                        <select 
                          value={demoForm.travelers}
                          onChange={(e) => handleDemoFormChange('travelers', parseInt(e.target.value))}
                          className="w-full px-4 py-3 bg-white/20 border border-white/30 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-cyan-400 text-sm"
                        >
                          <option className="bg-blue-800" value={1}>1 person</option>
                          <option className="bg-blue-800" value={2}>2 people</option>
                          <option className="bg-blue-800" value={3}>3-4 people</option>
                          <option className="bg-blue-800" value={5}>5+ people</option>
                        </select>
                      </div>
                      <div>
                        <label className="block text-sm font-semibold text-blue-200 mb-2">📅 Duration</label>
                        <select 
                          value={demoForm.duration}
                          onChange={(e) => handleDemoFormChange('duration', e.target.value)}
                          className="w-full px-4 py-3 bg-white/20 border border-white/30 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-cyan-400 text-sm"
                        >
                          <option className="bg-blue-800" value="3-5-days">3-5 days</option>
                          <option className="bg-blue-800" value="1-week">1 week</option>
                          <option className="bg-blue-800" value="2-weeks">2 weeks</option>
                          <option className="bg-blue-800" value="3-weeks">3+ weeks</option>
                        </select>
                      </div>
                    </div>
                    
                    {/* Travel Dates */}
                    <div className="grid grid-cols-2 gap-4">
                      <div>
                        <label className="block text-sm font-semibold text-blue-200 mb-2">📅 Departure Date</label>
                        <input 
