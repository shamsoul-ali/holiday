                        >
                          ✨ Let AI Suggest
                        </button>
                      </div>
                      <input 
                        type="text" 
                        value={demoForm.destination}
                        onChange={(e) => handleDemoFormChange('destination', e.target.value)}
                        placeholder={
                          demoForm.destinationMode === 'specific' 
                            ? "e.g., Tokyo, Japan" 
                            : "Leave blank for AI to suggest destinations based on your budget"
                        }
                        disabled={demoForm.destinationMode === 'ai-suggest'}
                        className={`w-full px-4 py-3 border border-white/30 rounded-xl text-white placeholder-blue-300 focus:outline-none focus:ring-2 focus:ring-cyan-400 focus:border-transparent text-sm transition-all duration-300 ${
                          demoForm.destinationMode === 'ai-suggest' 
                            ? 'bg-white/10 opacity-50 cursor-not-allowed' 
                            : 'bg-white/20'
                        }`}
                      />
                    </div>
                  </div>
                  
                  {/* Budget Section */}
                  <div>
                    <label className="block text-sm font-semibold text-blue-200 mb-3">
                      💰 Your Budget per Person (MYR)
                    </label>
                    <div className="space-y-3">
                      <input 
                        type="range"
                        min="1000"
                        max="20000"
                        step="500"
                        value={demoForm.budget}
                        onChange={(e) => handleDemoFormChange('budget', parseInt(e.target.value))}
