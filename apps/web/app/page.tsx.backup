                          {[
                            { key: 'halal', name: '🕌 Halal' },
                            { key: 'vegetarian', name: '🥗 Vegetarian' },
                            { key: 'kosher', name: '✡️ Kosher' }
                          ].map((pref) => (
                            <label key={pref.key} className="flex items-center space-x-1 cursor-pointer group">
                              <input
                                type="checkbox"
                                checked={demoForm.preferences[pref.key as keyof typeof demoForm.preferences]}
                                onChange={() => handlePreferenceChange(pref.key)}
                                className="h-3 w-3 text-cyan-400 focus:ring-cyan-500 border-white/30 rounded bg-white/20 transition-all duration-200"
                              />
                              <span className={`text-xs font-medium transition-colors duration-200 ${
                                demoForm.preferences[pref.key as keyof typeof demoForm.preferences]
                                  ? 'text-cyan-200'
                                  : 'text-blue-200 group-hover:text-blue-100'
                              }`}>
                                {pref.name}
                              </span>
                            </label>
                          ))}
                        </div>
                      </div>

                      {/* Accessibility & Special Needs */}
                      <div>
                        <h4 className="text-xs font-medium text-cyan-300 mb-2 uppercase tracking-wide">♿ Accessibility & Special Needs</h4>
                        <div className="grid grid-cols-2 gap-2">
                          {[
                            { key: 'wheelchair', name: '♿ Wheelchair Access' },
                            { key: 'elderly', name: '👴 Elderly-Friendly' },
                            { key: 'petFriendly', name: '🐕 Pet-Friendly' },
                            { key: 'childFriendly', name: '🧸 Child-Friendly' }
                          ].map((pref) => (
                            <label key={pref.key} className="flex items-center space-x-1 cursor-pointer group">
                              <input
                                type="checkbox"
                                checked={demoForm.preferences[pref.key as keyof typeof demoForm.preferences]}
                                onChange={() => handlePreferenceChange(pref.key)}
                                className="h-3 w-3 text-cyan-400 focus:ring-cyan-500 border-white/30 rounded bg-white/20 transition-all duration-200"
                              />
                              <span className={`text-xs font-medium transition-colors duration-200 ${
                                demoForm.preferences[pref.key as keyof typeof demoForm.preferences]
                                  ? 'text-cyan-200'
                                  : 'text-blue-200 group-hover:text-blue-100'
                              }`}>
                                {pref.name}
                              </span>
                            </label>
                          ))}
                        </div>
                      </div>

                    </div>
                    
                    {/* Selected Preferences Summary */}
                    <div className="mt-4 p-3 bg-white/5 rounded-lg border border-white/10">
                      <div className="flex items-center gap-2 mb-2">
                        <span className="text-xs font-semibold text-cyan-300">📋 Selected Preferences:</span>
                        <span className="text-xs bg-cyan-500/20 px-2 py-1 rounded-full text-cyan-200">
                          {Object.values(demoForm.preferences).filter(Boolean).length} selected
                        </span>
                      </div>
                      <div className="flex flex-wrap gap-1">
                        {Object.entries(demoForm.preferences)
                          .filter(([_, selected]) => selected)
                          .slice(0, 6)
                          .map(([key, _]) => {
                            const prefLabels: {[key: string]: string} = {
                              halal: '🕌', couples: '💑', city: '🏙️', food: '🍽️', 
                              hotels: '🏨', flights: '✈️', luxury: '👑', budget: '💰',
                              family: '👨‍👩‍👧‍👦', nature: '🏔️', culture: '🏛️', adventure: '🌊',
                              wellness: '🧘‍♀️', shopping: '🛍️', nightlife: '🌃', photography: '📸',
                              beaches: '🏖️', mountains: '⛰️', art: '🎨', music: '🎵'
                            }
                            return (
                              <span key={key} className="text-xs bg-cyan-500/10 px-2 py-1 rounded-full text-cyan-200">
                                {prefLabels[key] || '✓'}
                              </span>
                            )
                          })}
                        {Object.values(demoForm.preferences).filter(Boolean).length > 6 && (
                          <span className="text-xs bg-white/10 px-2 py-1 rounded-full text-blue-300">
                            +{Object.values(demoForm.preferences).filter(Boolean).length - 6} more
                          </span>
                        )}
                      </div>
                    </div>
                  </div>
                  
                  <button 
                    onClick={handleGenerateRecommendations}
                    disabled={isGenerating}
                    className={`w-full py-4 rounded-xl font-bold transition-all duration-300 shadow-lg hover:shadow-xl ${
                      isGenerating 
                        ? 'bg-gray-500 cursor-not-allowed' 
                        : 'bg-gradient-to-r from-cyan-500 to-blue-600 text-white hover:from-cyan-600 hover:to-blue-700 transform hover:scale-105'
                    }`}
                  >
                    <div className="flex items-center justify-center gap-2">
                      {isGenerating ? (
                        <>
                          <div className="animate-spin rounded-full h-5 w-5 border-b-2 border-white"></div>
                          <span>🧠 Generating AI Recommendations...</span>
                        </>
                      ) : (
                        <span>🧠 Generate AI Recommendations</span>
                      )}
                    </div>
                  </button>
                </div>
                
                {/* Loading State */}
                {isGenerating && (
                <div className="mt-6">
                  <div className="p-4 bg-gradient-to-r from-blue-500/20 to-cyan-500/20 rounded-xl border border-blue-400/30">
                    <div className="flex items-center gap-3 mb-3">
                      <div className="animate-spin rounded-full h-4 w-4 border-b-2 border-cyan-400"></div>
                      <span className="text-cyan-300 font-semibold">🤖 AI Processing Your Request...</span>
                    </div>
                    <div className="space-y-1 text-sm text-blue-200">
                      <p>🔍 Analyzing your preferences...</p>
                      <p>🌍 Searching global destinations...</p>
                      <p>💰 Calculating budget optimizations...</p>
                      <p>📅 Checking travel dates availability...</p>
                    </div>
                  </div>
                </div>
                )}

                {/* Enhanced Demo Results Preview */}
                {showResults && (
                <div className="mt-6 space-y-3">
                  <div className="p-4 bg-gradient-to-r from-green-500/20 to-emerald-500/20 rounded-xl border border-green-400/30">
                    <div className="flex items-center gap-3 mb-3">
                      <div className="w-3 h-3 bg-green-400 rounded-full animate-pulse"></div>
                      <span className="text-green-300 font-semibold">AI Analysis Complete</span>
                      <span className="text-green-200 text-xs bg-green-500/20 px-2 py-1 rounded-full">2.3s</span>
                    </div>
                    <div className="space-y-1 text-sm">
                      <p className="text-green-200">✅ 3 personalized itineraries ready</p>
                      {demoForm.preferences.halal && <p className="text-green-200">✅ Halal-certified restaurants found</p>}
                      {demoForm.preferences.couples && <p className="text-green-200">✅ Romantic experiences curated</p>}
                      {demoForm.preferences.city && <p className="text-green-200">✅ Urban attractions highlighted</p>}
                      {demoForm.preferences.food && <p className="text-green-200">✅ Local food tours included</p>}
                      {demoForm.preferences.luxury && <p className="text-green-200">✅ Premium accommodations selected</p>}
                      {demoForm.preferences.budget && <p className="text-green-200">✅ Budget-friendly options optimized</p>}
                      {demoForm.preferences.wheelchair && <p className="text-green-200">✅ Wheelchair accessible venues confirmed</p>}
                      {demoForm.preferences.photography && <p className="text-green-200">✅ Instagram-worthy spots mapped</p>}
                      <p className="text-green-200">✅ {Object.values(demoForm.preferences).filter(Boolean).length} preferences matched</p>
                    </div>
                  </div>
                  
                  <div className="grid grid-cols-3 gap-2 text-xs">
                    <div className="bg-white/10 rounded-lg p-3 text-center border border-white/20">
                      <div className="text-cyan-400 font-bold">BUDGET</div>
                      <div className="text-white mt-1">RM 3,200</div>
                      <div className="text-blue-200">3 countries</div>
                    </div>
                    <div className="bg-cyan-500/20 rounded-lg p-3 text-center border border-cyan-400/30">
                      <div className="text-cyan-300 font-bold">COMFORT</div>
                      <div className="text-white mt-1">RM 5,800</div>
                      <div className="text-blue-200">4 countries</div>
                    </div>
                    <div className="bg-white/10 rounded-lg p-3 text-center border border-white/20">
                      <div className="text-purple-400 font-bold">LUXURY</div>
                      <div className="text-white mt-1">RM 12,500</div>
                      <div className="text-blue-200">5 countries</div>
                    </div>
                  </div>
                  
                  <div className="text-center">
                    <button 
                      onClick={handleViewFullItineraries}
                      className="text-cyan-300 text-sm font-semibold hover:text-cyan-200 transition-colors duration-200"
                    >
                      👀 View Full Itineraries →
                    </button>
                  </div>
                </div>
                )}

                {/* Full Itineraries Modal */}
                {showFullItineraries && (
                  <div className="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
                    <div className="bg-white rounded-2xl max-w-4xl w-full max-h-[90vh] overflow-y-auto">
                      <div className="sticky top-0 bg-white border-b px-6 py-4 flex justify-between items-center">
                        <h2 className="text-2xl font-bold text-gray-900">Your AI-Generated Itineraries</h2>
                        <button
                          onClick={() => setShowFullItineraries(false)}
                          className="text-gray-400 hover:text-gray-600 text-2xl"
                        >
                          ×
                        </button>
                      </div>
                      
                      <div className="p-6">
                        {itinerariesData?.itineraries ? (
                          <div className="space-y-8">
                            {itinerariesData.itineraries.map((itinerary: any, index: number) => (
                              <div key={itinerary.id} className="border rounded-xl p-6 bg-gradient-to-r from-blue-50 to-indigo-50">
                                <div className="flex justify-between items-start mb-4">
                                  <div>
                                    <h3 className="text-xl font-bold text-gray-900 mb-2">{itinerary.title}</h3>
                                    <p className="text-gray-600">📍 {itinerary.destination}</p>
                                    <p className="text-gray-600">📅 {itinerary.duration} • {itinerary.travelers} travelers</p>
                                    {itinerary.weather && (
                                      <p className="text-gray-600">🌤️ {itinerary.weather.temperature}°C • {itinerary.weather.condition}</p>
                                    )}
                                  </div>
                                  <div className="text-right">
                                    <div className="text-2xl font-bold text-blue-600">
                                      RM {itinerary.price.total.toLocaleString()}
                                    </div>
                                    <div className="text-sm text-gray-500">
                                      RM {itinerary.price.perPerson.toLocaleString()} per person
                                    </div>
                                    <div className="text-sm text-gray-500">
                                      {itinerary.countries} countries
                                    </div>
                                  </div>
                                </div>

                                {/* Highlights */}
                                <div className="mb-6">
                                  <h4 className="font-semibold text-gray-900 mb-2">✨ Highlights</h4>
                                  <div className="grid grid-cols-1 md:grid-cols-2 gap-2">
                                    {itinerary.highlights.map((highlight: string, idx: number) => (
                                      <div key={idx} className="flex items-center text-sm text-gray-700">
                                        <span className="text-green-500 mr-2">✓</span>
                                        {highlight}
                                      </div>
                                    ))}
                                  </div>
                                </div>

                                {/* Accommodation & Transport */}
                                <div className="grid md:grid-cols-2 gap-4 mb-6">
                                  <div>
                                    <h4 className="font-semibold text-gray-900 mb-2">🏨 Accommodation</h4>
                                    <p className="text-sm text-gray-700">{itinerary.accommodation}</p>
                                  </div>
                                  <div>
                                    <h4 className="font-semibold text-gray-900 mb-2">🚗 Transport</h4>
                                    <div className="space-y-1">
                                      {itinerary.transport.map((transport: string, idx: number) => (
                                        <p key={idx} className="text-sm text-gray-700">{transport}</p>
                                      ))}
                                    </div>
                                  </div>
                                </div>

                                {/* Day by Day */}
                                <div className="mb-6">
                                  <h4 className="font-semibold text-gray-900 mb-3">📅 Day-by-Day Itinerary</h4>
                                  <div className="space-y-3">
                                    {itinerary.days.map((day: any, idx: number) => (
                                      <div key={idx} className="bg-white rounded-lg p-4 border">
                                        <h5 className="font-semibold text-gray-900 mb-2">{day.title}</h5>
                                        <div className="grid md:grid-cols-3 gap-4 text-sm">
                                          <div>
                                            <span className="font-medium text-gray-700">Activities:</span>
                                            <ul className="mt-1 space-y-1">
                                              {day.activities.map((activity: string, actIdx: number) => (
                                                <li key={actIdx} className="text-gray-600">• {activity}</li>
                                              ))}
                                            </ul>
                                          </div>
                                          <div>
                                            <span className="font-medium text-gray-700">Meals:</span>
                                            <ul className="mt-1 space-y-1">
                                              {day.meals.map((meal: string, mealIdx: number) => (
                                                <li key={mealIdx} className="text-gray-600">• {meal}</li>
                                              ))}
                                            </ul>
                                          </div>
                                          <div>
                                            <span className="font-medium text-gray-700">Stay:</span>
                                            <p className="mt-1 text-gray-600">{day.accommodation}</p>
                                          </div>
                                        </div>
                                      </div>
                                    ))}
                                  </div>
                                </div>

                                {/* Action Buttons */}
                                <div className="flex gap-3">
                                  <button className="flex-1 bg-blue-600 text-white py-3 rounded-lg font-semibold hover:bg-blue-700 transition-colors">
                                    🎯 Book This Itinerary
                                  </button>
                                  <button className="px-6 py-3 border border-blue-600 text-blue-600 rounded-lg font-semibold hover:bg-blue-50 transition-colors">
                                    📝 Customize
                                  </button>
                                </div>
                              </div>
                            ))}
                          </div>
                        ) : (
                          <div className="text-center py-12">
                            <div className="text-6xl mb-4">🎯</div>
                            <h3 className="text-xl font-semibold text-gray-900 mb-2">No Itineraries Generated Yet</h3>
                            <p className="text-gray-600">Please generate AI recommendations first to view full itineraries.</p>
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </motion.div>
          </div>
        </div>
      </section>

      {/* Top-10 Destinations Section */}
      <section className="py-20 bg-white">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            whileInView={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.6 }}
            viewport={{ once: true }}
            className="text-center mb-16"
          >
            <h2 className="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
              Top Destinations for Your Budget
            </h2>
            <p className="text-xl text-gray-600 max-w-2xl mx-auto">
              AI-curated recommendations based on real-time pricing, popularity trends, 
              and your preferences. From budget-friendly getaways to luxury escapes.
            </p>
          </motion.div>

          <Top10Carousel budget={selectedBudget} />
        </div>
      </section>

      {/* Features Section */}
      <section className="py-24 bg-gradient-to-br from-gray-50 to-white relative overflow-hidden">
        <div className="absolute inset-0 bg-travel-pattern opacity-3"></div>
        <div className="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            whileInView={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.6 }}
            viewport={{ once: true }}
            className="text-center mb-20"
          >
            <h2 className="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
              Why Travelers Choose Holiday AI?
            </h2>
            <p className="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
              We've analyzed thousands of travel pain points and built solutions that make planning 
              your dream vacation effortless and enjoyable.
            </p>
          </motion.div>

          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {[
              {
                icon: Globe,
                title: "Global Coverage & Real-time Data",
                description: "Access to 200+ countries with live pricing from major travel providers. No more outdated information or hidden costs.",
                benefits: ["Live pricing updates", "200+ destinations", "Real-time availability"],
                color: "from-blue-500 to-cyan-500"
              },
              {
                icon: TrendingUp,
                title: "AI-Powered Personalization",
                description: "Our AI learns your preferences, travel history, and style to create recommendations that match your unique needs.",
                benefits: ["Smart learning", "Personalized suggestions", "Style matching"],
                color: "from-purple-500 to-pink-500"
              },
              {
                icon: Shield,
                title: "Halal & Family-First Approach",
                description: "Specialized filters for halal dining, family-friendly activities, and cultural sensitivity that respects your values.",
                benefits: ["Halal-certified options", "Family activities", "Cultural respect"],
                color: "from-green-500 to-emerald-500"
              },
              {
                icon: Heart,
                title: "Emotional Intelligence",
                description: "We understand that travel is emotional. Our AI considers your feelings, memories, and aspirations, not just logistics.",
                benefits: ["Emotional matching", "Memory creation", "Aspiration fulfillment"],
                color: "from-red-500 to-pink-500"
              },
              {
                icon: Star,
                title: "Expert Curation & Local Insights",
                description: "Hand-picked recommendations from travel experts, local insiders, and verified travelers who've been there.",
                benefits: ["Expert verified", "Local knowledge", "Real experiences"],
                color: "from-yellow-500 to-orange-500"
              },
              {
                icon: MapPin,
                title: "Seamless Booking & Support",
                description: "Direct deep links to book flights, hotels, and activities instantly. Plus 24/7 AI support throughout your journey.",
                benefits: ["One-click booking", "24/7 support", "Journey assistance"],
                color: "from-indigo-500 to-purple-500"
              }
            ].map((feature, index) => (
              <motion.div
                key={index}
                initial={{ opacity: 0, y: 20 }}
                whileInView={{ opacity: 1, y: 0 }}
                transition={{ duration: 0.6, delay: index * 0.1 }}
                viewport={{ once: true }}
                className="group relative"
              >
                <div className="bg-white p-8 rounded-3xl shadow-xl hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-3 border border-gray-100 relative overflow-hidden">
                  {/* Background Gradient */}
                  <div className={`absolute inset-0 bg-gradient-to-br ${feature.color} opacity-0 group-hover:opacity-5 transition-opacity duration-500`}></div>
                  
                  {/* Icon */}
                  <div className={`w-20 h-20 bg-gradient-to-br ${feature.color} rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300`}>
                    <feature.icon className="h-10 w-10 text-white" />
                  </div>
                  
                  {/* Content */}
                  <h3 className="text-xl font-bold text-gray-900 mb-4 group-hover:text-gray-800 transition-colors duration-300">
                    {feature.title}
                  </h3>
                  <p className="text-gray-600 leading-relaxed mb-6">
                    {feature.description}
                  </p>
                  
                  {/* Benefits */}
                  <div className="space-y-2">
                    {feature.benefits.map((benefit, idx) => (
                      <div key={idx} className="flex items-center gap-2 text-sm">
                        <div className={`w-2 h-2 bg-gradient-to-r ${feature.color} rounded-full`}></div>
                        <span className="text-gray-700 font-medium">{benefit}</span>
                      </div>
                    ))}
                  </div>
                  
                  {/* Hover Effect */}
                  <div className="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-gray-200 to-transparent transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
                </div>
              </motion.div>
            ))}
          </div>
        </div>
      </section>

      {/* Trip Planning Section */}
      <section className="py-20 bg-white">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            whileInView={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.6 }}
            viewport={{ once: true }}
            className="text-center mb-16"
          >
            <h2 className="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
              Plan Your Perfect Trip
            </h2>
            <p className="text-xl text-gray-600 max-w-2xl mx-auto">
              Let our AI create a personalized itinerary that fits your budget, 
              preferences, and travel style.
            </p>
          </motion.div>

          <TripPlanningForm />
        </div>
      </section>

