'use client'

import { useState } from 'react'
import { motion } from 'framer-motion'
import { 
  Plane, 
  MapPin, 
  Calendar, 
  Users, 
  Search, 
  Star,
  TrendingUp,
  Globe,
  Shield,
  Heart
} from 'lucide-react'
import Top10Carousel from '../components/Top10Carousel'
import TripPlanningForm from '../components/TripPlanningForm'
import AuthModal from '../components/auth/AuthModal'
import UserMenu from '../components/auth/UserMenu'
import { useAuth } from '../components/providers/AuthProvider'

export default function HomePage() {
  const { user, loading } = useAuth()
  const [selectedBudget, setSelectedBudget] = useState(5000)
  const [isGenerating, setIsGenerating] = useState(false)
  const [showAuthModal, setShowAuthModal] = useState(false)
  
  // Enhanced demo form state
  const [demoForm, setDemoForm] = useState({
    destination: '',
    destinationMode: 'ai-suggest', // 'specific' or 'ai-suggest'
    budget: 5000,
    travelers: 2,
    duration: '1-week',
    startDate: '',
    endDate: '',
    preferences: {
      // Religious & Dietary
      halal: true,
      vegetarian: false,
      kosher: false,
      
      // Travel Style
      luxury: false,
      budget: false,
      backpacking: false,
      business: false,
      
      // Group Type
      family: false,
      couples: true,
      solo: false,
      friends: false,
      
      // Activities & Interests
      nature: false,
      city: true,
      culture: false,
      adventure: false,
      wellness: false,
      shopping: false,
      nightlife: false,
      photography: false,
      
      // Accommodation Preferences
      hotels: true,
      resorts: false,
      apartments: false,
      hostels: false,
      
      // Transportation
      flights: true,
      trains: false,
      roadTrip: false,
      cruises: false,
      
      // Special Interests
      food: true,
      art: false,
      music: false,
      sports: false,
      wildlife: false,
      beaches: false,
      mountains: false,
      
      // Accessibility & Special Needs
      wheelchair: false,
      elderly: false,
      petFriendly: false,
      childFriendly: false
    }
  })

  const handleDemoFormChange = (field: string, value: any) => {
    setDemoForm(prev => ({
      ...prev,
      [field]: value
    }))
  }

  const handlePreferenceChange = (pref: string) => {
    setDemoForm(prev => ({
      ...prev,
      preferences: {
        ...prev.preferences,
        [pref]: !prev.preferences[pref as keyof typeof prev.preferences]
      }
    }))
  }

  const handleGenerateRecommendations = async () => {
    setIsGenerating(true)
    
    try {
      // Call the API to generate itineraries
      const response = await fetch('/api/itineraries', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(demoForm),
      })

      if (response.ok) {
        const data = await response.json()
        
        // Simulate AI processing time for better UX
        await new Promise(resolve => setTimeout(resolve, 2500))
        
        // Redirect to results page with data
        const encodedData = encodeURIComponent(JSON.stringify(data.data))
        window.location.href = `/results?data=${encodedData}`
      } else {
        console.error('Failed to generate itineraries')
        setIsGenerating(false)
        // Could show error toast here
      }
    } catch (error) {
      console.error('Error calling API:', error)
      setIsGenerating(false)
      // Could show error toast here
    }
  }


  const getBudgetCategory = (budget: number) => {
    if (budget <= 3000) return { name: 'Budget', color: 'text-red-400' }
    if (budget <= 7000) return { name: 'Comfort', color: 'text-yellow-400' }
    if (budget <= 15000) return { name: 'Premium', color: 'text-blue-400' }
    return { name: 'Luxury', color: 'text-purple-400' }
  }

  const budgetOptions = [
    { value: 2000, label: 'RM 2,000', color: 'bg-green-100 text-green-800' },
    { value: 5000, label: 'RM 5,000', color: 'bg-blue-100 text-blue-800' },
    { value: 10000, label: 'RM 10,000', color: 'bg-purple-100 text-purple-800' },
    { value: 20000, label: 'RM 20,000', color: 'bg-orange-100 text-orange-800' },
  ]

  return (
    <div className="min-h-screen bg-gradient-to-br from-blue-50 via-white to-indigo-50">
      {/* Navigation Header */}
      <nav className="absolute top-0 left-0 right-0 z-50 bg-transparent">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex justify-between items-center h-20">
            {/* Logo */}
            <div className="flex items-center gap-3">
              <div className="p-2 bg-white/20 backdrop-blur-sm rounded-xl ring-2 ring-white/30">
                <Plane className="h-8 w-8 text-white" />
              </div>
              <span className="text-2xl font-bold text-white">Holiday AI</span>
            </div>

            {/* Navigation Links */}
            <div className="hidden md:flex items-center space-x-8">
              <a href="#destinations" className="text-white/80 hover:text-white transition-colors">
                Destinations
              </a>
              <a href="#features" className="text-white/80 hover:text-white transition-colors">
                Features
              </a>
              <a href="#how-it-works" className="text-white/80 hover:text-white transition-colors">
                How It Works
              </a>
            </div>

            {/* User Menu / Auth */}
            <div className="flex items-center">
              {loading ? (
                <div className="w-8 h-8 bg-white/20 rounded-full animate-pulse"></div>
              ) : (
                <UserMenu 
                  user={user} 
                  onAuthClick={() => setShowAuthModal(true)} 
                />
              )}
            </div>
          </div>
        </div>
      </nav>

      {/* Auth Modal */}
      <AuthModal 
        isOpen={showAuthModal} 
        onClose={() => setShowAuthModal(false)}
      />

      {/* Hero Section */}
      <section className="relative overflow-hidden bg-gradient-to-br from-blue-900 via-blue-800 to-indigo-900 text-white min-h-screen flex items-center">
        {/* Background Elements */}
        <div className="absolute inset-0 bg-travel-pattern opacity-5"></div>
        <div className="absolute inset-0 bg-gradient-to-br from-black/30 via-transparent to-black/20"></div>
        
        {/* Floating Elements */}
        <div className="absolute top-20 left-10 w-32 h-32 bg-blue-400/20 rounded-full blur-3xl animate-pulse"></div>
        <div className="absolute bottom-20 right-10 w-40 h-40 bg-indigo-400/20 rounded-full blur-3xl animate-pulse delay-1000"></div>
        <div className="absolute top-1/2 left-1/4 w-24 h-24 bg-cyan-400/20 rounded-full blur-2xl animate-bounce delay-500"></div>
        
        <div className="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
          <div className="grid lg:grid-cols-2 gap-12 items-center">
            {/* Left Content */}
            <motion.div
              initial={{ opacity: 0, x: -50 }}
              animate={{ opacity: 1, x: 0 }}
              transition={{ duration: 0.8 }}
              className="space-y-8"
            >
              {/* Logo & Badge */}
              <div className="flex items-center gap-4 mb-8">
                <div className="p-4 bg-white/20 backdrop-blur-sm rounded-2xl ring-4 ring-white/30">
                  <Plane className="h-12 w-12 text-white" />
                </div>
                <div className="bg-gradient-to-r from-cyan-400 to-blue-400 px-4 py-2 rounded-full">
                  <span className="text-sm font-bold text-white">AI-Powered Travel Planning</span>
                </div>
              </div>

              {/* Main Headline */}
              <div className="space-y-6">
                <h1 className="text-5xl lg:text-7xl font-bold font-display leading-tight">
                  Your AI Travel
                  <span className="block bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-400 bg-clip-text text-transparent">
                    Companion
                  </span>
                </h1>
                
                <p className="text-xl lg:text-2xl text-blue-100 leading-relaxed max-w-2xl">
                  Stop wasting hours researching travel options. Our AI understands your preferences, 
                  budget, and travel style to create personalized itineraries in minutes.
                </p>
              </div>

              {/* Problem-Solution Statement */}
              <div className="bg-white/10 backdrop-blur-sm rounded-2xl p-6 border border-white/20">
                <h3 className="text-lg font-semibold mb-3 text-cyan-300">🎯 What We Solve for You:</h3>
                <ul className="space-y-2 text-blue-100">
                  <li className="flex items-center gap-2">
                    <span className="w-2 h-2 bg-cyan-400 rounded-full"></span>
                    <span>Hours of research → <strong>2-minute AI analysis</strong></span>
                  </li>
                  <li className="flex items-center gap-2">
                    <span className="w-2 h-2 bg-cyan-400 rounded-full"></span>
                    <span>Generic recommendations → <strong>Personalized experiences</strong></span>
                  </li>
                  <li className="flex items-center gap-2">
                    <span className="w-2 h-2 bg-cyan-400 rounded-full"></span>
                    <span>Hidden costs → <strong>Transparent pricing</strong></span>
                  </li>
                  <li className="flex items-center gap-2">
                    <span className="w-2 h-2 bg-cyan-400 rounded-full"></span>
                    <span>Cultural mismatches → <strong>Halal & family-friendly options</strong></span>
                  </li>
                </ul>
              </div>

              {/* CTA Buttons */}
              <div className="flex flex-col sm:flex-row gap-4">
                <button className="bg-gradient-to-r from-cyan-500 to-blue-600 text-white px-8 py-4 rounded-2xl font-bold text-lg hover:from-cyan-600 hover:to-blue-700 transition-all duration-300 transform hover:scale-105 shadow-2xl hover:shadow-cyan-500/25">
                  Start Planning Now
                </button>
                <button className="bg-white/20 backdrop-blur-sm text-white px-8 py-4 rounded-2xl font-semibold text-lg hover:bg-white/30 transition-all duration-300 border border-white/30">
                  Watch Demo
                </button>
              </div>

              {/* Trust Indicators */}
              <div className="flex items-center gap-6 text-sm text-blue-200">
                <div className="flex items-center gap-2">
                  <div className="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
                  <span>AI-Powered Recommendations</span>
                </div>
                <div className="flex items-center gap-2">
                  <div className="w-2 h-2 bg-green-400 rounded-full animate-pulse delay-500"></div>
                  <span>Real-time Pricing</span>
                </div>
                <div className="flex items-center gap-2">
                  <div className="w-2 h-2 bg-green-400 rounded-full animate-pulse delay-1000"></div>
                  <span>24/7 Support</span>
