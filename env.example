# =============================================================================
# HOLIDAY AI PLATFORM - ENVIRONMENT CONFIGURATION
# =============================================================================

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_ENV=development
APP_NAME=Holiday AI Planner
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# =============================================================================
# WEB APPLICATION PORTS
# =============================================================================
WEB_PORT=3010
API_PORT=8000
DATABASE_PORT=5432
REDIS_PORT=6379

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://holiday_user:holiday_pass@localhost:5432/holiday_ai
POSTGRES_DB=holiday_ai
POSTGRES_USER=holiday_user
POSTGRES_PASSWORD=holiday_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# AUTHENTICATION (CLERK)
# =============================================================================
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_API_URL=https://api.clerk.com/v1

# =============================================================================
# AI & MACHINE LEARNING APIs
# =============================================================================
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-sonnet-20240229
ANTHROPIC_MAX_TOKENS=2000
ANTHROPIC_TEMPERATURE=0.7

# =============================================================================
# GOOGLE APIs
# =============================================================================
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_PROJECT_ID=your_google_project_id
GOOGLE_BILLING_ACCOUNT=your_billing_account_id

# Google Places API (for activities, restaurants, attractions)
GOOGLE_PLACES_API_KEY=${GOOGLE_API_KEY}

# Google Travel API (for travel insights, trends)
GOOGLE_TRAVEL_API_KEY=${GOOGLE_API_KEY}

# Google Flights API (for flight search)
GOOGLE_FLIGHTS_API_KEY=${GOOGLE_API_KEY}

# =============================================================================
# FLIGHT & TRAVEL SEARCH APIs
# =============================================================================
# Amadeus API (flights, hotels, activities)
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
AMADEUS_ENVIRONMENT=test  # test or production

# Kiwi/Tequila API (alternative flight search)
KIWI_API_KEY=your_kiwi_api_key
KIWI_PARTNER_ID=your_partner_id
KIWI_MARKET=MY

# Skyscanner API (flight comparisons)
SKYSCANNER_API_KEY=your_skyscanner_api_key
SKYSCANNER_COUNTRY=MY
SKYSCANNER_CURRENCY=MYR
SKYSCANNER_LOCALE=en-MY

# =============================================================================
# HOTEL & ACCOMMODATION APIs
# =============================================================================
# Expedia Rapid API (hotels, packages, activities)
EXPEDIA_RAPID_API_KEY=your_expedia_rapid_api_key

# Booking.com API (alternative hotel search)
BOOKING_API_KEY=your_booking_api_key

# Hotels.com API
HOTELS_API_KEY=your_hotels_api_key

# =============================================================================
# ACTIVITIES & EXPERIENCES APIs
# =============================================================================
# TripAdvisor API (reviews, attractions, restaurants)
TRIPADVISOR_RAPID_API_KEY=your_tripadvisor_rapid_api_key

# Viator API (activities, tours, experiences)
VIATOR_API_KEY=your_viator_api_key

# GetYourGuide API
GETYOURGUIDE_API_KEY=your_getyourguide_api_key

# Klook API (Asian activities)
KLOOK_API_KEY=your_klook_api_key

# =============================================================================
# TRANSPORTATION APIs
# =============================================================================
# Rail Europe API
RAIL_EUROPE_API_KEY=your_rail_europe_api_key

# Duffel API (modern flight search)
DUFFEL_API_KEY=your_duffel_api_key

# FlightAware API (flight tracking)
FLIGHTAWARE_API_KEY=your_flightaware_api_key

# =============================================================================
# WEATHER & CLIMATE APIs
# =============================================================================
OPENWEATHER_API_KEY=your_openweather_api_key
OPENWEATHER_UNITS=metric
OPENWEATHER_LANGUAGE=en

# WeatherAPI.com (alternative)
WEATHERAPI_KEY=your_weatherapi_key

# =============================================================================
# EVENTS & ENTERTAINMENT APIs
# =============================================================================
# Ticketmaster API
TICKETMASTER_API_KEY=your_ticketmaster_api_key

# Eventbrite API
EVENTBRITE_API_KEY=your_eventbrite_api_key

# Nager.Date API (public holidays)
NAGER_DATE_API_KEY=your_nager_date_api_key

# =============================================================================
# PAYMENT & FINANCIAL APIs
# =============================================================================
# Stripe (international payments)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# iPay88 (Malaysia payments)
IPAY88_MERCHANT_KEY=your_ipay88_merchant_key
IPAY88_MERCHANT_CODE=your_merchant_code
IPAY88_SIGNATURE_KEY=your_signature_key

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox  # sandbox or live

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
# Sentry (error tracking)
SENTRY_DSN=your_sentry_dsn_here

# OpenTelemetry
OTEL_ENDPOINT=your_otel_endpoint
OTEL_SERVICE_NAME=holiday-ai-api

# =============================================================================
# STORAGE & FILE MANAGEMENT
# =============================================================================
# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=holiday-ai-storage

# Cloudflare R2 (alternative to S3)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=holiday-ai-storage

# =============================================================================
# EMAIL & NOTIFICATIONS
# =============================================================================
# SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@holidayai.com

# Twilio (SMS notifications)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# =============================================================================
# SECURITY & ENCRYPTION
# =============================================================================
SECRET_KEY=your_secret_key_for_encryption
JWT_SECRET_KEY=your_jwt_secret_key
ENCRYPTION_KEY=your_32_character_encryption_key

# =============================================================================
# RATE LIMITING & CACHING
# =============================================================================
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000
CACHE_TTL_SECONDS=3600

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================
TESTING=false
MOCK_APIS=true  # Use mock data when APIs are not configured
API_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_UMRAH_MODULE=true
ENABLE_B2B_DASHBOARD=true
ENABLE_AI_RECOMMENDATIONS=true
ENABLE_REAL_TIME_PRICING=true
ENABLE_OFFLINE_MODE=true

# =============================================================================
# LOCALIZATION & INTERNATIONALIZATION
# =============================================================================
DEFAULT_LANGUAGE=en
DEFAULT_CURRENCY=MYR
DEFAULT_TIMEZONE=Asia/Kuala_Lumpur
SUPPORTED_LANGUAGES=en,ms,ar,zh,ta
SUPPORTED_CURRENCIES=MYR,USD,SGD,THB,IDR

# =============================================================================
# WEBHOOKS & INTEGRATIONS
# =============================================================================
WEBHOOK_SECRET=your_webhook_secret
SLACK_WEBHOOK_URL=your_slack_webhook_url
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# =============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================
# Google Analytics
GA_TRACKING_ID=your_ga_tracking_id

# Facebook Pixel
FB_PIXEL_ID=your_fb_pixel_id

# Hotjar
HOTJAR_ID=your_hotjar_id

# =============================================================================
# COMMISSION & REVENUE SHARING
# =============================================================================
DEFAULT_COMMISSION_RATE=0.12
LUXURY_COMMISSION_RATE=0.15
UMRAH_COMMISSION_RATE=0.18
AGENT_TIER_BONUSES=true

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================
EMAIL_NOTIFICATIONS=true
SMS_NOTIFICATIONS=false
PUSH_NOTIFICATIONS=true
PRICE_ALERTS=true
BOOKING_REMINDERS=true

# =============================================================================
# AI MODEL CONFIGURATION
# =============================================================================
AI_MODEL_PROVIDER=openai  # openai, anthropic, or hybrid
AI_FALLBACK_MODEL=gpt-3.5-turbo
AI_MAX_CONCURRENT_REQUESTS=10
AI_REQUEST_TIMEOUT=60
AI_CACHE_RESPONSES=true

# =============================================================================
# TRAVEL PREFERENCES & FILTERS
# =============================================================================
DEFAULT_HALAL_FILTER=true
DEFAULT_FAMILY_FRIENDLY=true
DEFAULT_ACCESSIBILITY_FILTER=false
DEFAULT_SUSTAINABILITY_FILTER=false
DEFAULT_LOCAL_EXPERIENCE_FILTER=true
